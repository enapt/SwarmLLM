[Unit]
Description=Check every few minutes for SwarmLLM anchor updates

[Timer]
# Every 4 minutes, so a published release reaches the anchor within ~5. The
# anchor is the node every fresh install bootstraps from, and since v0.3.271 a
# computer two releases behind is disconnected by updated ones (the anchor is
# exempt where it is a bootstrap peer, but a lagging anchor still serves new
# installs an old build's view). Hourly left the operator updating by hand.
#
# The check is a conditional request (`swarmllm-update.sh`): GitHub answers 304
# while the release list is unchanged, which does not count against its
# 60-an-hour unauthenticated limit, so 15 checks an hour cost nothing.
#
# The jitter spreads anchors that would otherwise wake on the same boundary;
# AccuracySec is lowered from systemd's default minute so the jitter, not
# timer coalescing, bounds the lag: worst case ~4 min 40 s plus the download.
OnBootSec=1min
OnUnitActiveSec=4min
RandomizedDelaySec=30s
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
