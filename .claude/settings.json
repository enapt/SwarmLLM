{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(cargo *)",
      "Bash(cargo)",
      "Bash(rustup *)",
      "Bash(git *)",
      "Bash(git)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(curl *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rustc *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(pgrep *)",
      "Bash(ps *)",
      "Bash(lsof *)",
      "Bash(ss *)",
      "Bash(tput *)",
      "Bash(seq *)",
      "Bash(test *)",
      "Bash(expr *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(stat *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(timeout *)",
      "Bash(pip3 *)",
      "Bash(sleep *)",
      "Bash(docker *)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(root-cause)",
      "Agent(general-purpose)",
      "Agent(feature-dev:code-explorer)",
      "Agent(feature-dev:code-architect)",
      "Agent(feature-dev:code-reviewer)",
      "Agent(claude-code-guide)",
      "Agent(security-reviewer)",
      "Agent(digest)"
    ],
    "deny": [
      "Bash(cargo publish *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./vendor/**/target/**/*)",
      "Read(./target/**/deps/**)",
      "Read(./target/**/build/**)",
      "Read(./target/**/incremental/**)",
      "Read(./target/**/.fingerprint/**)",
      "Read(./target/**/examples/**)"
    ]
  },
  "includeGitInstructions": false,
  "autoCompactWindow": 400000,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/research-gate.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/commit-gate.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/post-compact-status.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/instructions-loaded.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
