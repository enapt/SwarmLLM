{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(cargo *)",
      "Bash(cargo)",
      "Bash(rustup *)",
      "Bash(git *)",
      "Bash(git)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(curl *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rustc *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(pgrep *)",
      "Bash(ps *)",
      "Bash(lsof *)",
      "Bash(ss *)",
      "Bash(tput *)",
      "Bash(seq *)",
      "Bash(test *)",
      "Bash(expr *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(stat *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(timeout *)",
      "Bash(pip3 *)",
      "Bash(sleep *)",
      "Bash(docker *)",
      "Task(Explore)",
      "Task(Plan)",
      "Task(root-cause)",
      "Task(general-purpose)",
      "Task(feature-dev:code-explorer)",
      "Task(feature-dev:code-architect)",
      "Task(feature-dev:code-reviewer)"
    ],
    "deny": [
      "Bash(cargo publish *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./vendor/**/target/**/*)",
      "Read(./target/**/deps/**)",
      "Read(./target/**/build/**)",
      "Read(./target/**/incremental/**)",
      "Read(./target/**/.fingerprint/**)",
      "Read(./target/**/examples/**)"
    ]
  },
  "includeGitInstructions": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/pre-edit-check.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/research-gate.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/commit-gate.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.rs)|Write(*.rs)",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/post-edit-lint.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/post-compact-status.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/on-stop-verify.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/instructions-loaded.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
