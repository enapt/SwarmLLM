# ============================================================================
# SwarmLLM — CUDA GPU-accelerated Docker Image
# ============================================================================
# Build:  docker build -f Dockerfile.cuda -t swarmllm:cuda .
# Run:    docker run --gpus all -p 8800:8800 -p 8810:8810 swarmllm:cuda
# ============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Builder (CUDA dev image + Rust toolchain)
# ---------------------------------------------------------------------------
# R138 (closes R103 deferral): pin base images by digest. Re-capture with
# `docker buildx imagetools inspect nvidia/cuda:12.4.0-devel-ubuntu22.04`
# when bumping the tag.
FROM nvidia/cuda:12.4.0-devel-ubuntu22.04@sha256:28326fefd36d43ecf82447e9ca1175db639b931e234019b2807f35a0d1551656 AS builder

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies + Rust toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libssl-dev \
    pkg-config \
    libclang-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Rust via rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain 1.94.0
ENV PATH="/root/.cargo/bin:${PATH}"

# Override the workspace's `.cargo/config.toml` `target-cpu=native` so the
# image is portable across CPUs other than the build runner. Without this
# the binary SIGILLs on machines whose microarchitecture differs from the
# CI runner that built the image. See gotcha #39 in memory/MEMORY.md and
# the matching `RUSTFLAGS: ""` in `.github/workflows/{ci,release}.yml`.
ENV RUSTFLAGS=""

WORKDIR /build

# CUDA libraries live under /usr/local/cuda-12.4/lib64 in the
# nvidia/cuda:12.4.0-devel base image. The build's final link step
# needs `-lcuda` + `-lcudart` (emitted by candle-kernels' build.rs).
# `LIBRARY_PATH` is what gcc/lld read at link time to resolve `-l…`
# flags; `LD_LIBRARY_PATH` is for runtime and not what failed here.
# Without this the link errors with
#   rust-lld: error: unable to find library -lcudart
# Pinned alongside CUDA_PATH so a CUDA version bump only requires
# touching these two lines.
ENV CUDA_PATH=/usr/local/cuda
ENV LIBRARY_PATH=/usr/local/cuda/lib64:${LIBRARY_PATH}

# `candle-kernels` build.rs runs `nvidia-smi` to autodetect the GPU
# compute capability when building. Docker BuildKit cannot pass GPU
# devices through to `docker build` (GPUs only attach at `docker run
# --gpus all`), so the autodetect fails with:
#   ComputeCapDetectionFailed("Failed to run nvidia-smi: No such file…")
# Pin compute-cap to 75 (Turing — RTX 20-series / GTX 16 and up) so nvcc
# emits PTX targeting that arch. candle-kernels emits PTX, which the driver
# JIT-compiles at runtime to the user's actual GPU, so this is a *floor*:
# every card at or above sm_75 is covered, including Blackwell (RTX 50) via
# forward-compat JIT — the build toolkit version is irrelevant to which GPUs
# it runs on, which is why this image stays on the 12.4 base. Kept in step
# with release.yml, which lowered the binary floor 80→75 for the same reason
# (bf16-WMMA kernels disable below sm_80; harmless for the quantized path).
ENV CUDA_COMPUTE_CAP=75

# Cache dependency compilation
COPY Cargo.toml Cargo.lock build.rs ./
COPY vendor/ vendor/
COPY crates/swarmllm-frontend/Cargo.toml crates/swarmllm-frontend/Cargo.toml
COPY crates/swarmllm-types/Cargo.toml crates/swarmllm-types/Cargo.toml

# Create dummy sources for dependency caching
RUN mkdir -p src crates/swarmllm-frontend/src crates/swarmllm-types/src && \
    echo 'fn main() { println!("dummy"); }' > src/main.rs && \
    echo '' > src/lib.rs && \
    echo '' > crates/swarmllm-frontend/src/lib.rs && \
    echo '' > crates/swarmllm-types/src/lib.rs && \
    cargo build --release --features candle-cuda 2>/dev/null || true && \
    rm -rf src crates/swarmllm-frontend/src crates/swarmllm-types/src

# Copy full source and build with CUDA support
COPY src/ src/
COPY crates/ crates/
COPY frontend/ frontend/
COPY config/ config/
RUN cargo build --release --features candle-cuda

# ---------------------------------------------------------------------------
# Stage 2: Runtime (CUDA runtime image)
# ---------------------------------------------------------------------------
# R138 (closes R103 deferral): digest-pinned. Re-capture with
# `docker buildx imagetools inspect nvidia/cuda:12.4.0-runtime-ubuntu22.04`.
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04@sha256:af8bd179ed3bf69d4b63b19a763662a6141f0f62ef099283f68d0b14b4bab0e3

ENV DEBIAN_FRONTEND=noninteractive

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --shell /bin/bash swarmllm

# Copy binary from builder (already stripped via profile.release.strip = true)
COPY --from=builder /build/target/release/swarmllm /usr/local/bin/swarmllm
COPY config/default.toml /etc/swarmllm/default.toml

# Create data directory and set ownership
RUN mkdir -p /data && chown swarmllm:swarmllm /data

# NVIDIA runtime configuration — expose all GPUs
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Environment configuration
ENV SWARMLLM_NODE_DATA_DIR=/data
ENV SWARMLLM_NODE_LISTEN_PORT=8800
ENV SWARMLLM_LOGGING_LEVEL=info
ENV SWARMLLM_UI_OPEN_BROWSER_ON_START=false

# Expose ports:
#   8800/tcp  — HTTP API + admin dashboard
#   8810/tcp  — P2P (Noise+Yamux, primary transport)
#   8800/udp  — P2P (QUIC, optional)
EXPOSE 8800/tcp 8810/tcp 8800/udp

# Persistent data volume
VOLUME /data

# Health check against the readiness probe (no auth required)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8800/health/ready || exit 1

USER swarmllm
WORKDIR /data

ENTRYPOINT ["swarmllm"]
CMD ["run"]
